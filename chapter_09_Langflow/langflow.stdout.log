\u2502 \u2502                     advanced=True,\n                                    \u2502 \u2502
\u2502 \u2502                     value="https://api.groq.com",\n                     \u2502 \u2502
\u2502 \u2502                     real_time_refresh=True,\n        ),\n               \u2502 \u2502
\u2502 \u2502                     IntInput(\n            name="max_tokens",\n         \u2502 \u2502
\u2502 \u2502                     display_name="Max Output Tokens",\n                 \u2502 \u2502
\u2502 \u2502                     info="The maximum number of tokens to generate.",\n \u2502 \u2502
\u2502 \u2502                     advanced=True,\n        ),\n        SliderInput(\n  \u2502 \u2502
\u2502 \u2502                     name="temperature",\n                               \u2502 \u2502
