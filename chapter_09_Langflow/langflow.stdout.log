\u2502 \u2502                        generate.",\n            advanced=True,\n        \u2502 \u2502
\u2502 \u2502                        ),\n        SliderInput(\n                       \u2502 \u2502
\u2502 \u2502                        name="temperature",\n                            \u2502 \u2502
\u2502 \u2502                        display_name="Temperature",\n                    \u2502 \u2502
